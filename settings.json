{
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": ["<leader>", "c"],
      "commands": ["workbench.action.showCommands"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "d"],
      "commands": ["editor.action.goToImplementation"]
    },
    {
      "before": ["g", "b"],
      "commands": ["workbench.action.navigateBack"]
    },
    {
      "before": ["<leader>", "h"],
      "commands": ["editor.action.showDefinitionPreviewHover"]
    },
    {
      "before": ["o"],
      "after": ["o", "<Esc>"]
    },
    // Insert new up line without insert mode
    {
      "before": ["O"],
      "after": ["O", "<Esc>"]
    },
    // Better moving
    {
      "before": ["j"],
      "after": ["g", "j"]
    },
    // Toggle sidebar
    {
      "before": ["<leader>", "a"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    // Close active editor
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<Leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["<tab>"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<s-tab>"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["<leader>", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "c"],
      "commands": ["workbench.action.showCommands"]
    },
    {
      "before": ["<leader>", "s"],
      "commands": [":split"]
    },
    {
      "before": ["<leader>", "v"],
      "commands": [":vsplit"]
    },
    {
      "before": ["s"],
      "commands": ["vscode-easymotion.jumpToWord"]
    }
  ],
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-h>": false,
    "<C-c>": false,
    "<C-v>": false,
    "<C-n>": false
  },
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "rgba(2, 62, 138, 0.15)",
  "editor.fontFamily": "'DankMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
  // Palette reference:
  // white-dark: #dbe3ea
  // grey-light: #3a4b58
  // grey: #292c36
  // grey-dark: #1b1e28
  // blue-light: #ebf5fc
  // blue: #70d3fa
  // blue-dark: #4bc8fa
  // green-light: #ebedf5
  // green: #70e0c8
  // green-dark: #52a190
  // purple-light: #a9afd1
  // purple: #FF79C5
  // purple-dark: #c76196
  // warning: #f48c06
  // Norrsken screenshot token colors.
  "editor.semanticHighlighting.enabled": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
        {
          "name": "Keywords",
          "scope": [
            "keyword",
            "keyword.control",
            "keyword.control.export",
            "keyword.control.import",
            "keyword.control.conditional",
            "keyword.control.loop",
            "keyword.control.flow",
            "keyword.control.flow.throw",
            "storage",
            "storage.type",
            "storage.type.function",
            "storage.type.var",
            "storage.type.const",
            "storage.type.let",
            "storage.modifier"
          ],
          "settings": {
            "foreground": "#70e0c8",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Keyword operators",
          "scope": [
            "keyword.operator.new",
            "keyword.operator.expression.new",
            "keyword.operator.expression.typeof",
            "keyword.operator.expression.as",
            "keyword.operator.type.ts"
          ],
          "settings": {
            "foreground": "#70e0c8",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Operators",
          "scope": [
            "keyword.operator",
            "keyword.operator.assignment",
            "keyword.operator.comparison",
            "keyword.operator.logical",
            "keyword.operator.ternary",
            "keyword.operator.type.annotation"
          ],
          "settings": {
            "foreground": "#8b91a8"
          }
        },
        {
          "name": "Keyword operators override",
          "scope": [
            "keyword.operator.new",
            "keyword.operator.expression.new",
            "keyword.operator.expression.typeof",
            "keyword.operator.expression.as",
            "keyword.operator.type.ts"
          ],
          "settings": {
            "foreground": "#70e0c8",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Primitive types and language constants",
          "scope": [
            "storage.type.primitive",
            "storage.type.primitive.ts",
            "support.type.primitive",
            "support.type.primitive.ts",
            "support.type.builtin",
            "constant.language",
            "constant.language.null",
            "constant.language.undefined",
            "constant.language.boolean"
          ],
          "settings": {
            "foreground": "#70e0c8",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Type names",
          "scope": [
            "entity.name.type",
            "entity.name.type.ts",
            "entity.name.type.interface",
            "entity.name.type.class",
            "support.type",
            "support.class"
          ],
          "settings": {
            "foreground": "#b8d5f8",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Primitive types override",
          "scope": [
            "storage.type.primitive",
            "storage.type.primitive.ts",
            "support.type.primitive",
            "support.type.primitive.ts",
            "support.type.builtin",
            "support.type.builtin.ts"
          ],
          "settings": {
            "foreground": "#70e0c8",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Function declarations and calls",
          "scope": [
            "entity.name.function",
            "entity.name.function.ts",
            "entity.name.function.method",
            "support.function",
            "meta.function-call",
            "meta.function-call variable.other.property",
            "meta.function-call variable.other.object.property"
          ],
          "settings": {
            "foreground": "#70d3fa"
          }
        },
        {
          "name": "Uppercase constants",
          "scope": [
            "constant.other.caps",
            "variable.other.constant",
            "variable.other.constant.ts",
            "variable.other.constant.tsx",
            "meta.definition.variable.ts variable.other.constant.ts",
            "meta.definition.variable.tsx variable.other.constant.tsx"
          ],
          "settings": {
            "foreground": "#70d3fa",
            "fontStyle": "bold italic"
          }
        },
        {
          "name": "Plain variables and parameters",
          "scope": [
            "variable",
            "variable.other",
            "variable.other.readwrite",
            "variable.other.readwrite.ts",
            "variable.other.readwrite.tsx",
            "variable.parameter",
            "variable.parameter.ts",
            "variable.parameter.tsx",
            "meta.definition.variable"
          ],
          "settings": {
            "foreground": "#dbe3ea"
          }
        },
        {
          "name": "Object properties and fields",
          "scope": [
            "variable.other.property",
            "variable.other.property.ts",
            "variable.other.property.tsx",
            "variable.object.property",
            "variable.object.property.ts",
            "variable.object.property.tsx",
            "variable.other.object.property",
            "variable.other.object.property.ts",
            "variable.other.object.property.tsx",
            "support.variable.property",
            "support.variable.property.ts",
            "support.variable.property.tsx"
          ],
          "settings": {
            "foreground": "#a9afd1"
          }
        },
        {
          "name": "Method-call properties override",
          "scope": [
            "meta.function-call variable.other.property",
            "meta.function-call variable.other.property.ts",
            "meta.function-call variable.other.object.property",
            "meta.function-call variable.other.object.property.ts"
          ],
          "settings": {
            "foreground": "#70d3fa"
          }
        },
        {
          "name": "Uppercase constants override",
          "scope": [
            "constant.other.caps",
            "variable.other.constant",
            "variable.other.constant.ts",
            "variable.other.constant.tsx",
            "meta.definition.variable.ts variable.other.constant.ts",
            "meta.definition.variable.tsx variable.other.constant.tsx"
          ],
          "settings": {
            "foreground": "#70d3fa",
            "fontStyle": "bold italic"
          }
        },
        {
          "name": "Numbers",
          "scope": [
            "constant.numeric",
            "constant.numeric.integer",
            "constant.numeric.float"
          ],
          "settings": {
            "foreground": "#70e0c8",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Strings",
          "scope": [
            "string",
            "string.quoted",
            "string.template"
          ],
          "settings": {
            "foreground": "#70e0c8"
          }
        },
        {
          "name": "Comments",
          "scope": [
            "comment",
            "comment.line",
            "comment.block",
            "comment.block.documentation",
            "punctuation.definition.comment"
          ],
          "settings": {
            "foreground": "#4d6470",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Dots and semicolons",
          "scope": [
            "punctuation.accessor",
            "punctuation.separator.period",
            "punctuation.terminator.statement"
          ],
          "settings": {
            "foreground": "#f9d76a"
          }
        },
        {
          "name": "Commas and braces",
          "scope": [
            "punctuation.separator.comma",
            "punctuation.definition.block",
            "punctuation.section.block",
            "punctuation.section.embedded",
            "punctuation.bracket.curly",
            "meta.brace.curly"
          ],
          "settings": {
            "foreground": "#FF79C5"
          }
        },
        {
          "name": "Colons and type separators",
          "scope": [
            "punctuation.separator.key-value",
            "punctuation.separator.type",
            "punctuation.type.annotation"
          ],
          "settings": {
            "foreground": "#a9afd1"
          }
        },
        {
          "name": "Parentheses",
          "scope": [
            "punctuation.bracket.round",
            "punctuation.section.parens",
            "punctuation.definition.group",
            "meta.brace.round"
          ],
          "settings": {
            "foreground": "#f9d76a"
          }
        }
      ]
  },
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "keyword": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "keyword.operator": {
        "foreground": "#8b91a8"
      },
      "keyword.declaration": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "keyword.control.export": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "modifier": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "class": {
        "foreground": "#b8d5f8",
        "fontStyle": "italic"
      },
      "type": {
        "foreground": "#b8d5f8",
        "fontStyle": "italic"
      },
      "interface": {
        "foreground": "#b8d5f8",
        "fontStyle": "italic"
      },
      "typeParameter": {
        "foreground": "#b8d5f8",
        "fontStyle": "italic"
      },
      "type.defaultLibrary": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "parameter": {
        "foreground": "#dbe3ea"
      },
      "property": {
        "foreground": "#a9afd1"
      },
      "enumMember": {
        "foreground": "#a9afd1"
      },
      "variable": {
        "foreground": "#dbe3ea"
      },
      "variable.readonly": {
        "foreground": "#dbe3ea"
      },
      "variable.defaultLibrary": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "function": {
        "foreground": "#70d3fa"
      },
      "method": {
        "foreground": "#70d3fa"
      },
      "string": {
        "foreground": "#70e0c8"
      },
      "number": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "comment": {
        "foreground": "#4d6470",
        "fontStyle": "italic"
      }
    }
  },

  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "terminal.integrated.fontFamily": "monospace",
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorCustomizations": {
    // "editor.background": "#1e293b",
    "diffEditor.removedTextBackground": "#ff000026",
    "diffEditor.insertedTextBackground": "#00ff8026"
  },
  "editor.inlineSuggest.enabled": true,
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "git.autofetch": true,
  "extensions.ignoreRecommendations": true,
  "git.confirmSync": false,
  "vsicons.dontShowNewVersionMessage": true,
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "security.workspace.trust.untrustedFiles": "open",
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "never",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.tabSize": 2,
  "git.ignoreRebaseWarning": true,
  "gitlens.gitCommands.skipConfirmations": ["fetch:command", "switch:command"],
  "nxConsole.showNodeVersionOnStartup": false,
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "relative",
  "workbench.editor.enablePreview": false,
  "breadcrumbs.enabled": false,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://cmp.saghen.dev": true,
    "https://raw.githubusercontent.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://www.django-rest-framework.org": {
      "approveRequest": false,
      "approveResponse": true
    }
  },
  "chat.tools.terminal.autoApprove": {
    "nvim": true,
    "true": true,
    "bun": true
  },
  "terminal.integrated.initialHint": false,
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": true
  },
  "docker.extension.enableComposeLanguageServer": false,
  "files.trimTrailingWhitespace": true,
  "explorer.confirmDelete": false,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "editor.wordWrap": "on",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "chat.viewSessions.orientation": "stacked"
}
