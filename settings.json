{
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": ["<leader>", "c"],
      "commands": ["workbench.action.showCommands"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "d"],
      "commands": ["editor.action.goToImplementation"]
    },
    {
      "before": ["g", "b"],
      "commands": ["workbench.action.navigateBack"]
    },
    {
      "before": ["<leader>", "h"],
      "commands": ["editor.action.showDefinitionPreviewHover"]
    },
    {
      "before": ["o"],
      "after": ["o", "<Esc>"]
    },
    // Insert new up line without insert mode
    {
      "before": ["O"],
      "after": ["O", "<Esc>"]
    },
    // Better moving
    {
      "before": ["j"],
      "after": ["g", "j"]
    },
    // Toggle sidebar
    {
      "before": ["<leader>", "a"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    // Close active editor
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<Leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["<tab>"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<s-tab>"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["<leader>", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "c"],
      "commands": ["workbench.action.showCommands"]
    },
    {
      "before": ["<leader>", "s"],
      "commands": [":split"]
    },
    {
      "before": ["<leader>", "v"],
      "commands": [":vsplit"]
    },
    {
      "before": ["s"],
      "commands": ["vscode-easymotion.jumpToWord"]
    }
  ],
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-h>": false,
    "<C-c>": false,
    "<C-v>": false,
    "<C-n>": false
  },
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "rgba(2, 62, 138, 0.15)",
  "editor.fontFamily": "'DankMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
  // Palette reference:
  // white-dark: #dbe3ea
  // grey-light: #3a4b58
  // grey: #292c36
  // grey-dark: #1b1e28
  // blue-light: #ebf5fc
  // blue: #70d3fa
  // blue-dark: #4bc8fa
  // green-light: #ebedf5
  // green: #70e0c8
  // green-dark: #52a190
  // purple-light: #a9afd1
  // purple: #FF79C5
  // purple-dark: #c76196
  // warning: #f48c06
  // Token colors tuned to match the Skol - Norrsken screenshot palette.
  "editor.semanticHighlighting.enabled": false,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      // Generic italics for source files and markdown prose.
      {
        "scope": ["source"],
        "settings": {
          "fontStyle": "italic"
        }
      },
      // Markdown prose.
      {
        "scope": ["text.html.markdown"],
        "settings": {
          "fontStyle": "italic"
        }
      },
      // Comments.
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#3a4b58"
        }
      },
      // Punctuation and general constants.
      {
        "scope": [
          "punctuation",
          "meta.brace",
          "meta.delimiter",
          "support.type.property-name",
          "entity.name.tag",
          "constant",
          "constant.language",
          "constant.other.symbol",
          "markup.deleted"
        ],
        "settings": {
          "foreground": "#70d3fa"
        }
      },
      // Numbers and other numeric literals.
      {
        "scope": [
          "constant.numeric",
          "constant.numeric.integer",
          "constant.numeric.float"
        ],
        "settings": {
          "foreground": "#70e0c8",
          "fontStyle": "italic"
        }
      },
      // Booleans and nullish values.
      {
        "scope": [
          "constant.language.boolean",
          "constant.language.true",
          "constant.language.false"
        ],
        "settings": {
          "foreground": "#70e0c8",
          "fontStyle": "italic"
        }
      },
      // Strings and string-like attribute values.
      {
        "scope": [
          "string",
          "string.quoted",
          "string.template",
          "entity.other.attribute-name",
          "entity.name.tag.css",
          "entity.other.attribute-name.class.css",
          "entity.other.attribute-name.id.css",
          "support.function.builtin",
          "support.type.builtin",
          "markup.inserted"
        ],
        "settings": {
          "foreground": "#70e0c8"
        }
      },
      // Plain local variables and parameters.
      {
        "scope": [
          "variable",
          "variable.other",
          "variable.other.readwrite",
          "variable.other.readwrite.ts",
          "variable.other.readwrite.tsx",
          "variable.parameter",
          "variable.parameter.ts",
          "variable.parameter.tsx",
          "meta.definition.variable"
        ],
        "settings": {
          "foreground": "#dbe3ea"
        }
      },
      // Operators and punctuation tuned to the Norrsken TS sample.
      {
        "scope": [
          "keyword.operator",
          "keyword.operator.assignment",
          "keyword.operator.arrow",
          "keyword.operator.expression",
          "keyword.operator.type.annotation",
          "punctuation.separator.key-value",
          "punctuation.separator.type"
        ],
        "settings": {
          "foreground": "#a9afd1"
        }
      },
      {
        "scope": [
          "punctuation.separator.comma",
          "punctuation.definition.block",
          "punctuation.section.block",
          "punctuation.definition.parameters",
          "punctuation.section.embedded",
          "meta.brace.curly"
        ],
        "settings": {
          "foreground": "#FF79C5"
        }
      },
      {
        "scope": [
          "punctuation.section.parens",
          "punctuation.definition.group",
          "meta.brace.round",
          "punctuation.terminator.statement"
        ],
        "settings": {
          "foreground": "#f9d76a"
        }
      },
      // Object properties.
      {
        "scope": [
          "variable.other.property",
          "variable.other.property.ts",
          "variable.other.property.tsx",
          "variable.object.property",
          "variable.object.property.ts",
          "variable.object.property.tsx",
          "variable.other.object.property",
          "variable.other.object.property.ts",
          "variable.other.object.property.tsx",
          "variable.other.constant.property",
          "variable.other.constant.property.ts",
          "variable.other.constant.property.tsx",
          "variable.other.constant.object.property",
          "variable.other.constant.object.property.ts",
          "variable.other.constant.object.property.tsx",
          "support.variable.property",
          "support.variable.property.ts",
          "support.variable.property.tsx"
        ],
        "settings": {
          "foreground": "#a9afd1"
        }
      },
      // Function-valued object members and callable names.
      {
        "scope": [
          "meta.definition.property.ts entity.name.function.ts",
          "meta.definition.property.tsx entity.name.function.tsx",
          "entity.name.function",
          "support.function",
          "meta.function-call",
          "meta.function-call variable.other.property",
          "meta.function-call variable.other.property.ts",
          "meta.function-call variable.other.property.tsx",
          "meta.function-call variable.other.object.property",
          "meta.function-call variable.other.object.property.ts",
          "meta.function-call variable.other.object.property.tsx"
        ],
        "settings": {
          "foreground": "#70d3fa"
        }
      },
      // Functions, types, classes, and at-rules.
      {
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.class",
          "support.type",
          "meta.at-rule",
          "string.quoted.other.attribute-value"
        ],
        "settings": {
          "foreground": "#4bc8fa"
        }
      },
      // Import/export keywords and storage modifiers.
      {
        "scope": [
          "keyword.control.export",
          "keyword.control.import",
          "keyword.operator.expression.as",
          "storage.type.class",
          "storage.type.function",
          "storage.modifier"
        ],
        "settings": {
          "foreground": "#70e0c8",
          "fontStyle": "italic"
        }
      },
      // Core keywords and storage tokens.
      {
        "scope": [
          "keyword",
          "storage",
          "storage.type"
        ],
        "settings": {
          "foreground": "#70e0c8",
          "fontStyle": "italic"
        }
      },
      // Control-flow keywords like if, for, throw, and new.
      {
        "scope": [
          "keyword.control",
          "keyword.control.conditional",
          "keyword.control.loop",
          "keyword.control.flow.throw",
          "keyword.control.new",
          "keyword.operator.new",
          "keyword.operator.expression.new",
          "keyword.operator.expression.typeof"
        ],
        "settings": {
          "foreground": "#70e0c8",
          "fontStyle": "italic"
        }
      },
      // Return keywords.
      {
        "scope": [
          "keyword.control.flow.return",
          "keyword.control.flow.ts",
          "keyword.control.flow.tsx"
        ],
        "settings": {
          "foreground": "#70e0c8"
        }
      },
      // Explicit null and undefined values.
      {
        "scope": [
          "constant.language.null",
          "constant.language.undefined"
        ],
        "settings": {
          "foreground": "#70e0c8",
          "fontStyle": "italic"
        }
      },
      // All-caps constants.
      {
        "scope": [
          "constant.other.caps",
          "variable.other.constant",
          "variable.other.constant.ts",
          "variable.other.constant.tsx",
          "meta.definition.variable.ts variable.other.constant.ts",
          "meta.definition.variable.tsx variable.other.constant.tsx"
        ],
        "settings": {
          "foreground": "#70d3fa",
          "fontStyle": "bold italic"
        }
      },
      // Class and type names.
      {
        "scope": [
          "entity.name.class",
          "entity.name.type"
        ],
        "settings": {
          "foreground": "#b8d5f8",
          "fontStyle": "italic"
        }
      },
      // Regexes and emphasis markup.
      {
        "scope": [
          "string.regexp",
          "constant.other.character-class.regexp",
          "keyword.other.important",
          "markup.bold"
        ],
        "settings": {
          "foreground": "#f48c06"
        }
      },
      {
        "scope": ["markup.bold"],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": ["markup.italic"],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  // Semantic token colors override theme-provided semantic highlighting.
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "keyword": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "variable.constant": {
        "foreground": "#70d3fa",
        "fontStyle": "bold italic"
      },
      "class": {
        "foreground": "#b8d5f8",
        "fontStyle": "italic"
      },
      "property": {
        "foreground": "#a9afd1"
      },
      "enumMember": {
        "foreground": "#a9afd1"
      },
      "method": {
        "foreground": "#70d3fa"
      },
      "function": {
        "foreground": "#70d3fa"
      },
      "number": {
        "foreground": "#70e0c8",
        "fontStyle": "italic"
      },
      "type": {
        "foreground": "#b8d5f8",
        "fontStyle": "italic"
      },
      "variable.readonly.constant": {
        "foreground": "#70d3fa",
        "fontStyle": "italic"
      },
      "string": {
        "foreground": "#70e0c8"
      },
      "comment": {
        "foreground": "#3a4b58"
      },
      "parameter": {
        "foreground": "#dbe3ea"
      },
      "variable": {
        "foreground": "#dbe3ea"
      }
    }
  },
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "terminal.integrated.fontFamily": "monospace",
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorCustomizations": {
    // "editor.background": "#1e293b",
    "diffEditor.removedTextBackground": "#ff000026",
    "diffEditor.insertedTextBackground": "#00ff8026"
  },
  "editor.inlineSuggest.enabled": true,
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "git.autofetch": true,
  "extensions.ignoreRecommendations": true,
  "git.confirmSync": false,
  "vsicons.dontShowNewVersionMessage": true,
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "security.workspace.trust.untrustedFiles": "open",
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "never",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.tabSize": 2,
  "git.ignoreRebaseWarning": true,
  "gitlens.gitCommands.skipConfirmations": ["fetch:command", "switch:command"],
  "nxConsole.showNodeVersionOnStartup": false,
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "relative",
  "workbench.editor.enablePreview": false,
  "breadcrumbs.enabled": false,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://cmp.saghen.dev": true,
    "https://raw.githubusercontent.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://www.django-rest-framework.org": {
      "approveRequest": false,
      "approveResponse": true
    }
  },
  "chat.tools.terminal.autoApprove": {
    "nvim": true,
    "true": true,
    "bun": true
  },
  "terminal.integrated.initialHint": false,
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": true
  },
  "docker.extension.enableComposeLanguageServer": false,
  "files.trimTrailingWhitespace": true,
  "explorer.confirmDelete": false,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "editor.wordWrap": "on",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "js/ts.updateImportsOnFileMove.enabled": "always"
}
